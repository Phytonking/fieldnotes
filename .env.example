# Create an API key in the Vercel AI Gateway dashboard.
AI_GATEWAY_API_KEY=

# Optional text model for Eve background work; defaults to openai/gpt-5.5.
AI_GATEWAY_MODEL=

# Optional hosted chat memory database (Neon PostgreSQL). Keep this server-only.
DATABASE_URL=

# Optional free TinyFish key for Eve's search_web/fetch_web_page tools (https://agent.tinyfish.ai). Keep this server-only.
TINYFISH_API_KEY=
